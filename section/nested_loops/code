#include <iostream>

void multiplicationTable(int size)
{
    for(int i = 1; i <= size; i++) {

        for(int j = 1; j <= size; j++) {
            std::cout << i << " * " << j << " = " << i * j << std::endl;
            
        }    // end inner for
        std::cout << std::endl;  // separate this row from the next

    }
}

int main()
{

    multiplicationTable(5);
    return 0;
}